<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/FuelStationView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="?attr/actionBarSize">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"

        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="?attr/colorPrimary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16sp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/barLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/barLeftLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/brand"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Бренд"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/address"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="10sp"
                            android:text="адрес"
                            android:textColor="#FFFFFF" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/barRightLayout"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.cardview.widget.CardView
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="5sp"
                            app:cardBackgroundColor="@color/cardview_light_background"
                            app:cardCornerRadius="5dp">

                            <androidx.cardview.widget.CardView
                                android:layout_width="70dp"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="5dp">

                                <ImageView
                                    android:id="@+id/logo"
                                    android:layout_width="70dp"
                                    android:layout_height="70dp"
                                    android:scaleType="fitXY" />

                            </androidx.cardview.widget.CardView>

                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:id="@+id/distanceLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5sp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/near_me"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:layout_marginEnd="5dp"
                                android:background="#00E60E0E"
                                android:contentDescription="TODO"
                                app:srcCompat="@drawable/ic_near_me_white_24dp" />

                            <TextView
                                android:id="@+id/distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.23 км"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/services_group"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5sp"
                    android:clipToPadding="false"
                    app:chipSpacingHorizontal="5dp"
                    app:chipSpacingVertical="-10dp" />

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"


        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".ui.stationview"
            >

            <!-- TODO: Update blank fragment layout -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/ad_view_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginTop="16sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16sp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/priceList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:overScrollMode="never" />

                    <TextView
                        android:id="@+id/updated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="Данные актуальны на 14.07.2020" />

                    <Button
                        android:id="@+id/open_app"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:foregroundGravity="left|center"
                        android:foregroundTint="@color/cardview_light_background"
                        android:freezesText="false"
                        android:insetRight="5dp"
                        android:text="Открыть приложение"
                        android:textColor="@color/colorPrimary"
                        app:backgroundTint="#F2F3F5"
                        app:cornerRadius="100dp" />

                    <LinearLayout
                        android:id="@+id/contact_group"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/call"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:foreground="@drawable/ic_phone_gray_24dp"
                            android:foregroundGravity="center_vertical|center_horizontal"
                            android:foregroundTint="#3f8ae0"
                            android:freezesText="false"
                            android:insetRight="5dp"
                            android:textColor="@color/colorPrimary"
                            app:backgroundTint="#f2f3f5"
                            app:cornerRadius="100dp" />

                        <Button
                            android:id="@+id/mail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:foreground="@drawable/ic_mail_gray_24dp"
                            android:foregroundGravity="center_vertical|center_horizontal"
                            android:foregroundTint="#3f8ae0"
                            android:insetRight="5dp"
                            android:textColor="@color/colorPrimary"
                            app:backgroundTint="#f2f3f5"
                            app:cornerRadius="100dp" />

                        <Button
                            android:id="@+id/web"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:foreground="@drawable/ic_link_gray_24dp"
                            android:foregroundGravity="center_vertical|center_horizontal"
                            android:foregroundTint="#3f8ae0"
                            android:insetRight="5dp"
                            android:textColor="@color/colorPrimary"
                            app:backgroundTint="#f2f3f5"
                            app:cornerRadius="100dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/openRouteMap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        app:backgroundTint="@color/colorPrimary"
        app:rippleColor="#FFFFFF"
        app:srcCompat="@drawable/ic_navigation_white_24dp"
        app:tint="#FFFFFF" />

    "

</androidx.coordinatorlayout.widget.CoordinatorLayout>